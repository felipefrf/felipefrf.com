---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { person } from '../data/site';
import { ui, switchPath, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  /** false for pages that exist in one language only */
  translated?: boolean;
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  lang = 'en',
  translated = true,
  title = `${person.name}, ${person.role}`,
  description = 'Felipe Ribeiro builds AI agents that do real work: founding engineer at a stealth AI startup, founder of MedAlvo, aerospace engineering at ITA, international physics olympiad medalist.',
  ogImage: ogPath = '/og.png',
  jsonLd: pageJsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const altPath = switchPath(Astro.url.pathname, other);
const enUrl = new URL(switchPath(Astro.url.pathname, 'en'), Astro.site);
const ptUrl = new URL(switchPath(Astro.url.pathname, 'pt'), Astro.site);
const ogImage = new URL(ogPath, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: Astro.site?.toString(),
  jobTitle: 'AI Engineer',
  alumniOf: 'Instituto Tecnológico de Aeronáutica (ITA)',
  sameAs: [person.github, person.linkedin],
};
const jsonLd = pageJsonLd ?? personLd;
---

<!doctype html>
<html lang={ui[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      translated && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F7F5F0" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui[lang].ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      translated && (
        <script is:inline data-alt={altPath} data-lang={lang}>
          // Language routing: a saved choice wins; otherwise a Portuguese browser goes to
          // /pt/, and, when the site sits behind the Cloudflare proxy, so do visitors from
          // Portuguese-speaking countries (read from /cdn-cgi/trace).
          (function () {
            var s = document.currentScript, alt = s.dataset.alt, here = s.dataset.lang;
            var go = function (l) { if (l !== here) location.replace(alt + location.search + location.hash); };
            var saved = null;
            try { saved = localStorage.getItem('lang'); } catch (e) {}
            if (saved === 'en' || saved === 'pt') return go(saved);
            var nav = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
            if (nav.indexOf('pt') === 0) return go('pt');
            if (here === 'pt') return;
            try { if (sessionStorage.getItem('geo')) return; sessionStorage.setItem('geo', '1'); } catch (e) {}
            fetch('/cdn-cgi/trace', { cache: 'no-store' })
              .then(function (r) { return r.ok ? r.text() : ''; })
              .then(function (t) {
                var m = /loc=([A-Z]{2})/.exec(t);
                if (m && /^(BR|PT|AO|MZ|CV|GW|ST|TL)$/.test(m[1])) go('pt');
              })
              .catch(function () {});
          })();
        </script>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
