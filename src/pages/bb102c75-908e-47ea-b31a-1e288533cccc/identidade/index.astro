---
// Private preview: four light identities for felipefrf.com on the same
// content. Pick one with the switcher (or ?v=a|b|c|d). Not linked, noindex.
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../../../styles/identidade.css';

const variants = [
  { id: 'a', name: 'Papel', note: 'Editorial, papel quente, tinta e um vermelhão. Atlas de engenharia.' },
  { id: 'b', name: 'Estúdio', note: 'Branco de produto, sombras suaves, cobalto. Limpo como um lançamento.' },
  { id: 'c', name: 'Carta', note: 'Carta aeronáutica: grade fina, azul-marinho, anotações técnicas.' },
  { id: 'd', name: 'Luz', note: 'Claro com cor: gradientes suaves, vidro, serifa itálica.' },
];
const impact = [
  { v: 'Top 10%', l: 'da turma no ITA', d: 'A escola de engenharia mais prestigiada do Brasil' },
  { v: '1º', l: 'lugar geral, ouro', d: 'Olimpíada Iberoamericana de Física 2020' },
  { v: '50+', l: 'medalhas em olimpíadas', d: '2 internacionais, 2017–2020' },
  { v: 'Melhor', l: 'projeto de satélite', d: 'Matsumoto-2, II SPOCS no ITA, 2026' },
];
const imp = ['01-home', '05-deslocamento', '08-montagem-fotos', '10-aceite-cliente'];
---

<!doctype html>
<html lang="pt-BR" data-id="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Identidade · felipefrf.com</title>
    <script is:inline>
      // pick the variant before first paint
      (function () {
        var v = new URLSearchParams(location.search).get('v');
        if (/^[abcd]$/.test(v || '')) document.documentElement.dataset.id = v;
      })();
    </script>
  </head>
  <body>
    <div class="switcher" role="group" aria-label="Identidade">
      <span class="sw-label">Identidade</span>
      {
        variants.map((v) => (
          <button type="button" data-v={v.id} title={v.note}>
            <b>{v.id.toUpperCase()}</b> {v.name}
          </button>
        ))
      }
      <span class="sw-note" data-sw-note></span>
    </div>

    <header class="nav">
      <a class="brand" href="#top"><span class="mark">F</span>Felipe Ribeiro</a>
      <nav>
        <a href="#trabalho">Trabalho</a>
        <a href="#medalhas">Medalhas</a>
        <a href="#contato" class="nav-cta">Contato</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" data-hero>
        <canvas class="hero-canvas" aria-hidden="true"></canvas>
        <div class="sat-label hidden" data-sat-label aria-hidden="true"><i></i><span>Matsumoto-2</span><small>SAR banda C · 620 km</small></div>
        <div class="hero-copy">
          <p class="kicker"><span class="dot"></span>Founding engineer na Hexagon · ITA</p>
          <h1>Agentes de IA que <em>fazem</em> o trabalho.</h1>
          <p class="lead">
            Sou o <strong>Felipe</strong>. Construo produtos de IA de ponta a ponta e coloco na mão de gente de verdade. Nas horas vagas toco a <strong>MedAlvo</strong>, que já dá lucro.
          </p>
          <div class="ctas">
            <a class="btn primary" href="#trabalho">Veja o que construí</a>
            <a class="btn ghost" href="#contato">Fale comigo</a>
          </div>
        </div>
        <dl class="hud">
          <div class="hud-head"><span><i class="rec"></i>Simulação ao vivo</span><span>física orbital real · 420×</span></div>
          <div><dt>ALT</dt><dd><span data-tel="alt">620,0</span> km</dd></div>
          <div><dt>VEL</dt><dd><span data-tel="vel">7,546</span> km/s</dd></div>
          <div><dt>LAT</dt><dd><span data-tel="lat">0,00</span>°</dd></div>
          <div><dt>LON</dt><dd><span data-tel="lon">0,00</span>°</dd></div>
        </dl>
      </section>

      <section class="impact wrap">
        {
          impact.map((n, i) => (
            <div class="cell" data-rise style={`--i:${i}`}>
              <b>{n.v}</b>
              <span>{n.l}</span>
              <small>{n.d}</small>
            </div>
          ))
        }
      </section>

      <section class="work wrap" id="trabalho">
        <div class="sec-head" data-rise>
          <p class="kicker">Trabalho</p>
          <h2>Coisas que <em>funcionam</em>, para gente de verdade.</h2>
        </div>

        <div class="bento">
          <article class="tile medalvo" data-rise data-tilt>
            <div class="tile-copy">
              <p class="tag">Fundador · 2026</p>
              <h3>MedAlvo</h3>
              <p>Preparação para residência médica feita em cima das provas oficiais. Agentes de IA montam o banco de questões; eu toco a empresa nas horas vagas.</p>
              <ul class="nums">
                <li><b>189.157</b> questões oficiais</li>
                <li><b>334</b> instituições</li>
                <li><b>Lucro</b> desde o lançamento</li>
              </ul>
            </div>
            <div class="frame browser">
              <div class="bar"><i></i><i></i><i></i><span>medalvo.com.br</span></div>
              <video muted loop playsinline autoplay preload="metadata" poster="/media/medalvo-poster.jpg">
                <source src="/media/medalvo.webm" type="video/webm" />
                <source src="/media/medalvo.mp4" type="video/mp4" />
              </video>
            </div>
          </article>

          <article class="tile cos" data-rise data-tilt>
            <div class="tile-copy">
              <p class="tag">Pessoal · 2026</p>
              <h3>Chief of staff de IA</h3>
              <p>Lê WhatsApp, Slack, e-mail e reuniões, descobre o que depende de mim e deixa tudo pronto. Eu só aprovo, pelo celular.</p>
            </div>
            <div class="frame phone">
              <video muted loop playsinline autoplay preload="metadata" poster="/media/cos-app-poster.jpg">
                <source src="/media/cos-app.webm" type="video/webm" />
                <source src="/media/cos-app.mp4" type="video/mp4" />
              </video>
            </div>
          </article>

          <article class="tile imperio" data-rise data-tilt>
            <div class="tile-copy">
              <p class="tag">Cliente · Ápice</p>
              <h3>Império Eventos</h3>
              <p>O app que guia cada equipe de montagem pelo dia, uma etapa por vez, enquanto o escritório acompanha ao vivo.</p>
            </div>
            <div class="frame phone dark" data-cycle>
              {imp.map((n, i) => <img src={`/media/imperio/app/${n}.webp`} alt="" class:list={{ on: i === 0 }} loading="lazy" />)}
            </div>
          </article>

          <article class="tile curo" data-rise data-tilt>
            <div class="tile-copy">
              <p class="tag">Com meu irmão · YC interview</p>
              <h3>Curo</h3>
              <p>Atendimento ao paciente pelo WhatsApp, e um painel onde a clínica vê cada caso e o que o agente fez.</p>
              <a class="link" href="/curo/painel/?lang=pt">Abrir o painel →</a>
            </div>
            <div class="frame browser">
              <div class="bar"><i></i><i></i><i></i><span>felipefrf.com/curo/painel</span></div>
              <video muted loop playsinline autoplay preload="metadata" poster="/media/curo-painel-poster.jpg">
                <source src="/media/curo-painel.webm" type="video/webm" />
                <source src="/media/curo-painel.mp4" type="video/mp4" />
              </video>
            </div>
          </article>

          <article class="tile flights" data-rise data-tilt>
            <div class="tile-copy">
              <p class="tag">Projeto pessoal</p>
              <h3>Flight Price Finder</h3>
              <p>Acha passagens hidden-city: um bilhete para mais longe que faz conexão onde você quer descer. Fortaleza → São Paulo: R$ 724 a menos.</p>
              <a class="link" href="/flights/">Testar a demo →</a>
            </div>
            <div class="frame browser">
              <div class="bar"><i></i><i></i><i></i><span>felipefrf.com/flights</span></div>
              <img src="/img/flights-demo.webp" alt="" loading="lazy" />
            </div>
          </article>
        </div>
      </section>

      <section class="medals wrap" id="medalhas">
        <div class="sec-head" data-rise>
          <p class="kicker">Olimpíadas</p>
          <h2>Antes de <em>tudo isso</em>.</h2>
        </div>
        <div class="medal-row">
          <figure class="medal" data-rise>
            <canvas data-medal="/3d/medal-gold-pt.glb"></canvas>
            <figcaption><b>Ouro, 1º no geral</b><span>Olimpíada Iberoamericana de Física 2020</span></figcaption>
          </figure>
          <figure class="medal" data-rise style="--i:1">
            <canvas data-medal="/3d/medal-silver-pt.glb"></canvas>
            <figcaption><b>Prata, 16º no geral</b><span>Olimpíada Nórdico-Báltica de Física 2020</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="contact wrap" id="contato">
        <h2>Vamos construir algo <em>que aguente.</em></h2>
        <div class="ctas">
          <a class="btn primary" href="mailto:felipe.frf27@gmail.com">felipe.frf27@gmail.com</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/felipe-farias-ribeiro">LinkedIn</a>
          <a class="btn ghost" href="https://github.com/felipefrf">GitHub</a>
        </div>
      </section>
    </main>

    <script>
      import type { OrbitPalette } from '../../../scripts/orbit';
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = document.documentElement;

      const PAL: Record<string, Partial<OrbitPalette>> = {
        a: { light: true, bg: 0xf3efe6, core: 0xece6d9, dayDot: [0.09, 0.075, 0.06], nightDot: [0.55, 0.5, 0.42], dotAlpha: [0.6, 1], ring: 0x16130f, ringOpacity: 0.09, atmoLo: [0.85, 0.6, 0.45], atmoHi: [0.95, 0.75, 0.55], atmoStrength: 0.55, stars: 0x16130f, starOpacity: 0, accent: 0xd9481c, leo: 0x2d4a8a, heo: 0x16130f },
        b: { light: true, bg: 0xf5f5f7, core: 0xffffff, dayDot: [0.18, 0.22, 0.32], nightDot: [0.68, 0.72, 0.8], dotAlpha: [0.6, 1], ring: 0x0b0b0f, ringOpacity: 0.07, atmoLo: [0.55, 0.65, 1.0], atmoHi: [0.7, 0.8, 1.0], atmoStrength: 0.7, stars: 0x0b0b0f, starOpacity: 0, accent: 0x2f5bff, leo: 0xff7a45, heo: 0x0b0b0f },
        c: { light: true, bg: 0xf1efe6, core: 0xf6f4ec, dayDot: [0.06, 0.16, 0.36], nightDot: [0.5, 0.58, 0.72], dotAlpha: [0.6, 1], ring: 0x0f2a5a, ringOpacity: 0.18, atmoLo: [0.4, 0.55, 0.8], atmoHi: [0.5, 0.65, 0.9], atmoStrength: 0.35, stars: 0x0f2a5a, starOpacity: 0, accent: 0xe4572e, leo: 0x0f2a5a, heo: 0x6b7a99 },
        d: { light: true, bg: 0xfbfaf8, core: 0xfdfcff, dayDot: [0.28, 0.22, 0.48], nightDot: [0.78, 0.74, 0.9], dotAlpha: [0.6, 1], ring: 0x121216, ringOpacity: 0.06, atmoLo: [0.98, 0.7, 0.6], atmoHi: [0.62, 0.55, 1.0], atmoStrength: 0.8, stars: 0x121216, starOpacity: 0, accent: 0x7a5cff, leo: 0xff7a45, heo: 0x2fbf8f },
      };

      // ---- hero simulation, rebuilt in the palette of the chosen identity ----
      const hero = document.querySelector<HTMLElement>('[data-hero]')!;
      const fmt = (d: number) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
      const f1 = fmt(1), f2 = fmt(2), f3 = fmt(3);
      const tel = (k: string) => hero.querySelector<HTMLElement>(`[data-tel="${k}"]`)!;
      let stop: (() => void) | null = null;
      let mod: typeof import('../../../scripts/orbit') | null = null;
      const boot = async () => {
        mod ??= await import('../../../scripts/orbit');
        stop?.();
        const old = hero.querySelector('canvas')!;
        const c = old.cloneNode() as HTMLCanvasElement;
        old.replaceWith(c);
        try {
          stop = mod.startOrbit(c, {
            reduced,
            host: hero,
            label: hero.querySelector('[data-sat-label]'),
            palette: { ...mod.NIGHT, ...PAL[root.dataset.id || 'a'] } as OrbitPalette,
            onTelemetry: (d) => {
              tel('alt').textContent = f1.format(d.alt);
              tel('vel').textContent = f3.format(d.vel);
              tel('lat').textContent = f2.format(d.lat);
              tel('lon').textContent = f2.format(d.lon);
            },
          });
          requestAnimationFrame(() => hero.classList.add('ready'));
        } catch {
          /* no WebGL */
        }
      };

      // ---- switcher ----
      const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-v]')];
      const note = document.querySelector<HTMLElement>('[data-sw-note]')!;
      const set = (v: string, rebuild = true) => {
        root.dataset.id = v;
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
        note.textContent = btns.find((b) => b.dataset.v === v)?.title ?? '';
        const u = new URL(location.href);
        u.searchParams.set('v', v);
        history.replaceState(null, '', u);
        if (rebuild) boot();
      };
      btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.v!)));
      set(root.dataset.id || 'a', false);
      boot();

      // ---- reveals ----
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { threshold: 0.15 },
      );
      document.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));

      // ---- tiles lean toward the pointer ----
      if (!reduced && matchMedia('(pointer: fine)').matches)
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((t) => {
          t.addEventListener('pointermove', (e) => {
            const r = t.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
            t.style.setProperty('--rx', `${(-y * 3).toFixed(2)}deg`);
            t.style.setProperty('--ry', `${(x * 4).toFixed(2)}deg`);
            t.style.setProperty('--mx', `${((x + 0.5) * 100).toFixed(1)}%`);
            t.style.setProperty('--my', `${((y + 0.5) * 100).toFixed(1)}%`);
          });
          t.addEventListener('pointerleave', () => {
            t.style.setProperty('--rx', '0deg');
            t.style.setProperty('--ry', '0deg');
          });
        });

      // ---- Império phone cycles through the field app ----
      document.querySelectorAll<HTMLElement>('[data-cycle]').forEach((f) => {
        const imgs = [...f.querySelectorAll('img')];
        let i = 0;
        if (!reduced) setInterval(() => { imgs[i].classList.remove('on'); i = (i + 1) % imgs.length; imgs[i].classList.add('on'); }, 2600);
      });

      // ---- medals ----
      const cans = [...document.querySelectorAll<HTMLCanvasElement>('canvas[data-medal]')];
      const mio = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        mio.disconnect();
        import('../../../scripts/medal3d').then(({ startMedal }) => cans.forEach((c) => startMedal(c, c.dataset.medal!, reduced)));
      }, { rootMargin: '500px' });
      cans.forEach((c) => mio.observe(c));
    </script>
  </body>
</html>
