---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Handwriting from '../components/Handwriting.astro';
import Medal from '../components/Medal.astro';
import Systems from '../components/Systems.astro';
import CuroChat from '../components/CuroChat.astro';
import '../styles/home.css';
import {
  person,
  impact,
  featured,
  apice,
  more,
  jobs,
  earlier,
  building,
  medals,
  receipts,
  medalList,
  national,
  otherHonors,
  education,
  toolbox,
  flightPath,
} from '../data/site';

// Trajectory plot: one cubic Bézier in a 1200×340 box, waypoints sampled along it.
const W = 1200;
const H = 340;
const P = [
  [30, 312],
  [520, 312],
  [840, 230],
  [1080, 66],
];
const at = (t: number) => {
  const u = 1 - t;
  const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
  return [a * P[0][0] + b * P[1][0] + c * P[2][0] + d * P[3][0], a * P[0][1] + b * P[1][1] + c * P[2][1] + d * P[3][1]];
};
const ts = [0.05, 0.25, 0.45, 0.63, 0.81, 1];
const waypoints = flightPath.map((w, i) => {
  const [x, y] = at(ts[i]);
  return { ...w, x, y, t: ts[i], last: i === flightPath.length - 1, first: i === 0 };
});
const pathD = `M${P[0].join(' ')} C${P[1].join(' ')} ${P[2].join(' ')} ${P[3].join(' ')}`;
const [ex, ey] = P[3];
const nextD = `M${ex} ${ey} L${ex + 92} ${ey - 64}`;

const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrowUp = `<svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<Base>
  <a class="skip" href="#main">Skip to content</a>
  <Nav
    links={[
      { href: '#systems', label: 'Systems' },
      { href: '#work', label: 'Work' },
      { href: '#log', label: 'Journey' },
      { href: '#honors', label: 'Medals' },
      { href: '#how', label: 'How I work' },
    ]}
    cta={{ href: '#contact', label: 'Contact' }}
  />

  <main id="main">
    <!-- hero -->
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="now rise" style="--i:0">
            <span class="pulse" aria-hidden="true"></span>
            <span><b>Now</b> · {person.now} · {person.nowPlace}</span>
          </div>
          <h1 id="hero-title">
            <span class="line rise" style="--i:1">I build AI agents</span>
            <span class="line rise fade" style="--i:2">that do <span class="serif">real</span> work.</span>
          </h1>
          <p class="lead rise" style="--i:3">
            I’m <strong>Felipe</strong>. I build production AI end to end: the LLM orchestration, the product around it and
            the guardrails that keep it safe. Right now I’m a founding engineer on <strong>Milo</strong>, where every employee
            gets an agent in its own microVM. Before that, agents that renegotiate debt at <strong>NG.CASH</strong>, and on the
            side <strong>MedAlvo</strong>, a prep company that runs itself. I like systems where a wrong answer costs real
            money, so I build them to <span class="mark">fail loud, not silent.</span>
          </p>
          <div class="ctas rise" style="--i:4">
            <a class="btn btn-primary" href="#systems">See how they work <Fragment set:html={arrow} /></a>
            <a class="btn btn-ghost" href={`mailto:${person.email}`}>Get in touch</a>
          </div>
        </div>

        <figure class="portrait rise" style="--i:2">
          <div class="photo">
            <img src="/img/felipe.jpg" width="460" height="460" alt="Illustrated portrait of Felipe Ribeiro wearing an ITA varsity jacket" />
          </div>
          <figcaption>
            <span class="mono">Felipe Ribeiro</span>
            <span>AI engineer · ITA ’27</span>
          </figcaption>
        </figure>
      </div>

      <figure class="figure rise" style="--i:5" aria-label="Career trajectory from olympiads to today">
        <div class="plot">
          <div class="plot-inner">
            <svg viewBox={`0 0 ${W} ${H}`} role="presentation">
              <path class="path" d={pathD} pathLength="1" />
              <path class="path-next" d={nextD} style="--d:1" />
              {
                waypoints.map((w) => (
                  <circle class:list={['dot', { 'now-dot': w.last }]} cx={w.x} cy={w.y} r={w.last ? 6 : 5} style={`--d:${w.t}`} />
                ))
              }
            </svg>
            {
              waypoints.map((w) => (
                <div
                  class:list={['wp', { right: w.last, 'now-wp': w.last, keep: w.first || w.last }]}
                  style={`left:${pct(w.x, W)};top:${pct(w.y, H)};--d:${w.t}`}
                >
                  <span class="mono">{w.year}</span>
                  <span>{w.label}</span>
                </div>
              ))
            }
          </div>
        </div>
        <figcaption class="fig-caption mono">
          <span>Fig. 1: Trajectory, not to scale</span>
          <span>Still climbing ↗</span>
        </figcaption>
      </figure>
    </section>

    <!-- impact -->
    <section class="wrap impact" aria-label="Highlights" data-reveal>
      {
        impact.map((n) => (
          <div class:list={['impact-cell', { accent: n.accent, 'has-logo': n.logo }]}>
            {n.logo && <img class="impact-logo" src={n.logo} alt="ITA" width="124" height="47" loading="lazy" />}
            <b {...(n.count ? { 'data-count': n.count, 'data-suffix': n.suffix } : {})}>{n.value}</b>
            <span class="what">{n.label}</span>
            <span class="detail">{n.detail}</span>
          </div>
        ))
      }
    </section>

    <!-- systems -->
    <section class="block wrap" id="systems" aria-labelledby="systems-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>01</i><span>Inside the systems</span></div>
          <h2 id="systems-title">How the things I build <span class="serif">actually work</span></h2>
        </div>
        <p>Results are the output. This is everything in between: how messages, models and deterministic code move through what I build. Real architecture, illustrative runs.</p>
      </div>
      <div data-reveal>
        <Systems />
      </div>
    </section>

    <!-- selected work -->
    <section class="block wrap" id="work" aria-labelledby="work-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>02</i><span>Selected work</span></div>
          <h2 id="work-title">Things I’ve <span class="serif">built</span></h2>
        </div>
        <p>A company that makes money, a startup that got as far as a YC interview, open-source tools people install, and what I’m hacking on now.</p>
      </div>

      {
        featured.map((p) => (
          <article class:list={['feature', p.slug]} data-reveal>
            <div class="feature-body">
              <div class="feature-meta mono">
                <span class:list={{ live: p.status }}>{p.kind}</span>
                <span>{p.year}</span>
              </div>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              {p.points && (
                <ul class="points">
                  {p.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              {p.stats && (
                <div class="stats">
                  {p.stats.map((s) => (
                    <div>
                      <b>{s.value}</b>
                      <span>{s.label}</span>
                    </div>
                  ))}
                </div>
              )}
              <ul class="tags" aria-label="Stack">
                {p.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              {p.status && (
                <p class="status mono">
                  <span class="pulse" aria-hidden="true" />
                  {p.status}
                </p>
              )}
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l, i) => (
                    <a class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.href} {...ext(l.href)}>
                      {l.label} <Fragment set:html={arrow} />
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="feature-media">
              {p.slug === 'medalvo' && (
                <div class="browser">
                  <div class="browser-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span>medalvo.com.br</span>
                  </div>
                  <video data-inview muted loop playsinline preload="metadata" poster="/media/medalvo-poster.jpg" aria-label="MedAlvo landing page in motion: adaptive study dashboard with streaks, timers and exam questions">
                    <source src="/media/medalvo.webm" type="video/webm" />
                    <source src="/media/medalvo.mp4" type="video/mp4" />
                  </video>
                </div>
              )}
              {p.slug === 'penpad' && (
                <div class="sheet-wrap">
                  <Handwriting alt="A page of damped-oscillator physics notes rendered in handwriting by penpad" />
                </div>
              )}
              {p.slug === 'curo' && <CuroChat />}
              {p.slug === 'flights' && (
                <div class="route" aria-label="Hidden-city example: SSA to CGH direct costs R$381, while a SSA to FLN ticket via CGH costs R$248; you get off at CGH and save R$133.">
                  <svg viewBox="0 0 560 360" role="img">
                    <title>Hidden-city fare: get off at the connection</title>
                    <path id="leg-a" class="leg" d="M70 250 C 170 120, 260 110, 300 170" />
                    <path class="leg-direct" d="M70 250 C 150 330, 250 300, 300 170" />
                    <path class="leg-skip" d="M300 170 C 360 230, 430 250, 490 210" />
                    <circle class="ap" cx="70" cy="250" r="9" />
                    <circle class="ap hit" cx="300" cy="170" r="11" />
                    <circle class="ap ghost" cx="490" cy="210" r="9" />
                    <circle class="plane" r="6">
                      <animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.7;1" calcMode="linear">
                        <mpath href="#leg-a" />
                      </animateMotion>
                    </circle>
                    <text x="70" y="285" class="code">SSA</text>
                    <text x="300" y="138" class="code">CGH</text>
                    <text x="490" y="245" class="code ghost">FLN</text>
                    <text x="70" y="304" class="city">Salvador</text>
                    <text x="300" y="120" class="city">São Paulo · get off here</text>
                    <text x="490" y="264" class="city ghost">never flown</text>
                    <g class="tag direct" transform="translate(120 318)">
                      <rect width="150" height="30" rx="15" />
                      <text x="75" y="20">Direct · R$381</text>
                    </g>
                    <g class="tag best" transform="translate(130 62)">
                      <rect width="190" height="30" rx="15" />
                      <text x="95" y="20">SSA→CGH→FLN · R$248</text>
                    </g>
                    <g class="save" transform="translate(400 70)">
                      <rect width="120" height="44" rx="12" />
                      <text x="60" y="29">−R$133</text>
                    </g>
                  </svg>
                </div>
              )}
            </div>
          </article>
        ))
      }

      <!-- Ápice -->
      <article class="apice" data-reveal>
        <div class="apice-head">
          <div class="feature-meta mono">
            <span>{apice.kind}</span>
            <span>{apice.year}</span>
          </div>
          <h3>{apice.name}</h3>
          <p>{apice.blurb}</p>
          <a class="btn btn-sm btn-primary" href={apice.href} target="_blank" rel="noopener">See Ápice <Fragment set:html={arrow} /></a>
        </div>
        <ul class="apice-work">
          {
            apice.work.map((w) => (
              <li>
                <span class="mono">{w.client}</span>
                <h4>{w.name}</h4>
                <p>{w.what}</p>
              </li>
            ))
          }
        </ul>
      </article>

      <ul class="index" data-reveal>
        {
          more.map((p) => (
            <li>
              <a href={p.links[0].href} target="_blank" rel="noopener">
                <span class="name">{p.name}</span>
                <span class="kind mono">{p.kind}</span>
                <span class="blurb">{p.blurb}</span>
                <Fragment set:html={arrowUp} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="index-foot">
        <a class="textlink" href={person.github} target="_blank" rel="noopener">Everything else on GitHub ↗</a>
      </div>
    </section>

    <!-- journey -->
    <section class="block wrap" id="log" aria-labelledby="log-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>03</i><span>Journey</span></div>
          <h2 id="log-title">Flight <span class="serif">log</span></h2>
        </div>
        <p>Remote roles across San Francisco, São Paulo, Belgium and New York, a few banks before that, and the things I built and led along the way.</p>
      </div>

      <div class="log">
        {
          jobs.map((j) => (
            <article class="entry" data-reveal>
              <span class="dates mono">{j.dates}</span>
              <div class="entry-main">
                <h3 class="co">
                  {j.company}
                  <small>{j.role}</small>
                </h3>
                <p>{j.summary}</p>
                <ul>
                  {j.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
              <span class="place">{j.place}</span>
            </article>
          ))
        }
      </div>

      <div class="log-more">
        <div data-reveal>
          <h3 class="mono sub-head">Earlier: internships & research</h3>
          <ul class="mini">
            {
              earlier.map((e) => (
                <li>
                  <span class="dates mono">{e.dates}</span>
                  <span class="who">
                    <b>{e.company}</b> {e.role}
                  </span>
                  <span class="note">{e.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal>
          <h3 class="mono sub-head">Building & leading</h3>
          <ul class="mini">
            {
              building.map((e) => (
                <li>
                  <span class="dates mono">{e.dates}</span>
                  <span class="who">
                    <b>{e.name}</b> {e.role}
                  </span>
                  <span class="note">{e.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- medals -->
    <section class="block wrap" id="honors" aria-labelledby="honors-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>04</i><span>Olympiads & honors</span></div>
          <h2 id="honors-title">Before all <span class="serif">this</span></h2>
        </div>
        <p>From 2017 to 2020 I trained for physics, math and robotics olympiads. It’s where I learned to like problems that don’t have a known answer yet.</p>
      </div>

      <div class="medals">
        {
          medals.map((m) => (
            <figure class:list={['medal-card', m.kind]} data-tilt data-reveal>
              <div class="medal-wrap">
                <Medal kind={m.kind} mark={m.rank} sub={m.kind === 'gold' ? 'TOP GOLD' : 'SILVER'} ring={m.ring} />
              </div>
              <figcaption>
                <span class="mono scope">
                  <img src={m.logo} alt="" width="28" height="28" loading="lazy" />
                  International · {m.year}
                </span>
                <b>{m.title}</b>
                <span>{m.event} ({m.short})</span>
                <small>{m.note}</small>
              </figcaption>
            </figure>
          ))
        }
        <div class="medal-card bulk" data-reveal data-medals>
          <span class="mono scope">National · 2017–2020</span>
          <b class="big" data-count="50" data-suffix="+">50+</b>
          <span class="bulk-label">national olympiad medals</span>
          <ul class="chips">
            {
              national.map((n) => (
                <li title={n.full}>
                  <b>{n.name}</b> {n.result}
                </li>
              ))
            }
          </ul>
          <button class="btn btn-sm btn-primary see-all" type="button" data-medals-open aria-expanded="false" aria-controls="medal-list">
            See the full list <Fragment set:html={arrow} />
          </button>
          <div class="medal-list" id="medal-list" hidden>
            <div class="medal-list-head">
              <span class="mono">Main medals · {medalList.length} of 50+</span>
              <button class="close" type="button" data-medals-close aria-label="Close the list">×</button>
            </div>
            <ul>
              {
                medalList.map((m) => (
                  <li>
                    <i class:list={['m-dot', m.medal]} aria-label={`${m.medal} medal`} />
                    <span class="mono y">{m.year}</span>
                    <span class="n">{m.name}</span>
                    <span class="mono sc">{m.scope}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="receipts">
        <figure class="receipt cert" data-reveal>
          <div class="paper">
            <img src={receipts.certificate.src} width="1100" height="778" loading="lazy" decoding="async" alt="Certificate of the Olimpiada Iberoamericana de Física virtual 2020 issued to Felipe Farias Ribeiro Filho, representing Brazil" />
          </div>
          <figcaption>
            <span>{receipts.certificate.caption}</span>
            <a class="textlink mono" href={receipts.certificate.announcement} target="_blank" rel="noopener">SBF announcement ↗</a>
          </figcaption>
        </figure>

        <figure class="receipt table" data-reveal>
          <div class="sheet-doc">
            <div class="doc-title">
              <span>Olimpiada Iberoamericana de Física 2020</span>
              <b>MEDALLERO</b>
            </div>
            <table>
              <thead>
                <tr>{receipts.oibfRow.cols.map((c) => <th>{c}</th>)}</tr>
              </thead>
              <tbody>
                <tr class="me">{receipts.oibfRow.row.map((c, i) => <td class:list={{ gold: i === 3 }}>{c}</td>)}</tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
              </tbody>
            </table>
          </div>
          <figcaption>
            <span>{receipts.oibfRow.caption}</span>
            <a class="textlink mono" href={receipts.certificate.medalTable} target="_blank" rel="noopener">Official medal table ↗</a>
          </figcaption>
        </figure>

        <figure class="receipt score" data-reveal>
          <div class="sheet-doc">
            <div class="doc-title">
              <span>NBPhO 2020 final results</span>
              <b><em>{receipts.nbpho.total}</em> / {receipts.nbpho.max} pts · #{receipts.nbpho.rank}</b>
            </div>
            <ul class="bars">
              {
                receipts.nbpho.problems.map((pr) => (
                  <li style={`--w:${((pr.got / pr.max) * 100).toFixed(1)}%`} class:list={{ full: pr.got === pr.max }}>
                    <span class="mono">P{pr.n}</span>
                    <i />
                    <span class="mono v">
                      {pr.got}/{pr.max}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <figcaption>
            <span>Silver, 16th overall</span>
            <a class="textlink mono" href={receipts.nbpho.href} target="_blank" rel="noopener">Official results ↗</a>
          </figcaption>
        </figure>
      </div>

      <div class="honor-row">
        {
          otherHonors.map((h) => (
            <figure class="honor-mini" data-reveal>
              {h.photo && (
                <div class="honor-photo">
                  <img src={h.photo} width="1600" height="1200" loading="lazy" decoding="async" alt="The SkyLens team on stage at the Nameless Hackathon, under a screen that reads “2º lugar · SkyLens”" />
                </div>
              )}
              <figcaption>
                <b>{h.title}</b>
                <span>{h.event}</span>
                <small>{h.note}</small>
              </figcaption>
            </figure>
          ))
        }
        <div class="school" data-reveal>
          <img class="school-logo" src={education.logo} alt="ITA emblem" width="496" height="188" loading="lazy" />
          <div class="school-copy">
            <span class="mono">Education · {education.dates}</span>
            <h3>{education.school}</h3>
            <p>{education.degree}. {education.note}</p>
          </div>
          <div class="school-entry">
            {
              education.entry.map((e) => (
                <div>
                  <b>{e.value}</b>
                  <span>{e.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- how I work -->
    <section class="block wrap" id="how" aria-labelledby="how-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>05</i><span>How I work</span></div>
          <h2 id="how-title">AI-native, <span class="serif">by default</span></h2>
        </div>
      </div>

      <div class="work-grid">
        <div class="prose" data-reveal>
          <p>
            Most of my code is written <strong>with a fleet of agents</strong>: Claude Code and Codex running in parallel git
            worktrees, on a remote box, inside tmux. I spend my time on specs, review and evals.
          </p>
          <p>
            I ship <strong>eval-first</strong>. If a change touches a model, it doesn’t merge until it passes suites built from
            real production cases. Anything that has to be exact, like prices, money and credentials, stays in deterministic
            code and out of the model’s hands.
          </p>
          <div class="terminal">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <pre><span class="p">~</span> tmux attach -t fleet
  agent-1  feat/streaming     <span class="ok">✓ evals passing</span>
  agent-2  fix/retry-backoff  <span class="ok">✓ evals passing</span>
  agent-3  chore/qa-batch     running…</pre>
          </div>
          <p class="term-note mono">Illustrative. The agent box sits behind a Cloudflare tunnel on this same domain.</p>
        </div>

        <div class="toolbox" data-reveal>
          {
            toolbox.map((g) => (
              <div>
                <span class="mono">{g.area}</span>
                <ul class="tags">
                  {g.items.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- contact -->
    <section class="contact wrap" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" data-reveal>
        Let’s build something<br /><span class="fade">that <span class="serif">holds up.</span></span>
      </h2>
      <div class="contact-row" data-reveal>
        <a class="btn btn-primary" href={`mailto:${person.email}`}>{person.email} <Fragment set:html={arrow} /></a>
        <button class="btn btn-ghost copy" type="button" data-copy={person.email}><span class="label">Copy email</span></button>
        <a class="btn btn-ghost" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href={person.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </section>

    <Footer />
  </main>
</Base>
