---
// The home page in its light identity ("day"), for the private preview while
// the type and accent are being chosen. Same content and sections as the live
// page; only the look changes, plus the switcher below.
import Home from './Home.astro';
import '@fontsource-variable/libre-franklin';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/host-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/day.css';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Home lang={lang} look="day" />
