---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Handwriting from '../components/Handwriting.astro';
import Medal from '../components/Medal.astro';
import Systems from '../components/Systems.astro';
import ChiefOfStaff from '../components/ChiefOfStaff.astro';
import '../styles/home.css';
import { getSite } from '../data';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const {
  person,
  impact,
  featured,
  apice,
  more,
  jobs,
  earlier,
  building,
  medals,
  receipts,
  medalList,
  national,
  otherHonors,
  education,
  toolbox,
  flightPath,
} = getSite(lang);

// Trajectory plot: one cubic Bézier in a 1200×340 box, waypoints sampled along it.
const W = 1200;
const H = 340;
const P = [
  [30, 312],
  [520, 312],
  [840, 230],
  [1080, 66],
];
const at = (t: number) => {
  const u = 1 - t;
  const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
  return [a * P[0][0] + b * P[1][0] + c * P[2][0] + d * P[3][0], a * P[0][1] + b * P[1][1] + c * P[2][1] + d * P[3][1]];
};
const ts = [0.05, 0.25, 0.45, 0.63, 0.81, 1];
const waypoints = flightPath.map((w, i) => {
  const [x, y] = at(ts[i]);
  return { ...w, x, y, t: ts[i], last: i === flightPath.length - 1, first: i === 0 };
});
const pathD = `M${P[0].join(' ')} C${P[1].join(' ')} ${P[2].join(' ')} ${P[3].join(' ')}`;
const [ex, ey] = P[3];
const nextD = `M${ex} ${ey} L${ex + 92} ${ey - 64}`;

const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrowUp = `<svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<Base lang={lang} title={t.title} description={t.description}>
  <a class="skip" href="#main">{t.skip}</a>
  <Nav
    lang={lang}
    links={[
      { href: '#chief', label: t.nav.chief },
      { href: '#systems', label: t.nav.systems },
      { href: '#work', label: t.nav.work },
      { href: '#log', label: t.nav.journey },
      { href: '#honors', label: t.nav.medals },
      { href: '#how', label: t.nav.how },
    ]}
    cta={{ href: '#contact', label: t.nav.contact }}
  />

  <main id="main">
    <!-- hero -->
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="now rise" style="--i:0">
            <span class="pulse" aria-hidden="true"></span>
            <span><b>{t.now}</b> · {person.now} · {person.nowPlace}</span>
          </div>
          <h1 id="hero-title">
            <span class="line rise" style="--i:1">{t.h1a}</span>
            <span class="line rise fade" style="--i:2" set:html={t.h1b} />
          </h1>
          <p class="lead rise" style="--i:3" set:html={t.lead} />
          <div class="ctas rise" style="--i:4">
            <a class="btn btn-primary" href="#systems">{t.ctaSystems} <Fragment set:html={arrow} /></a>
            <a class="btn btn-ghost" href={`mailto:${person.email}`}>{t.ctaContact}</a>
          </div>
        </div>

        <figure class="portrait rise" style="--i:2">
          <div class="photo">
            <img src="/img/felipe.jpg" width="460" height="460" alt={t.portraitAlt} />
          </div>
          <figcaption>
            <span class="mono">Felipe Ribeiro</span>
            <span>{t.portraitRole}</span>
          </figcaption>
        </figure>
      </div>

      <figure class="figure rise" style="--i:5" aria-label={t.trajectoryLabel}>
        <div class="plot">
          <div class="plot-inner">
            <svg viewBox={`0 0 ${W} ${H}`} role="presentation">
              <path class="path" d={pathD} pathLength="1" />
              <path class="path-next" d={nextD} style="--d:1" />
              {
                waypoints.map((w) => (
                  <circle class:list={['dot', { 'now-dot': w.last }]} cx={w.x} cy={w.y} r={w.last ? 6 : 5} style={`--d:${w.t}`} />
                ))
              }
            </svg>
            {
              waypoints.map((w) => (
                <div
                  class:list={['wp', { right: w.last, 'now-wp': w.last, keep: w.first || w.last }]}
                  style={`left:${pct(w.x, W)};top:${pct(w.y, H)};--d:${w.t}`}
                >
                  <span class="mono">{w.year}</span>
                  <span>{w.label}</span>
                </div>
              ))
            }
          </div>
        </div>
        <figcaption class="fig-caption mono">
          <span>{t.fig1}</span>
          <span>{t.climbing}</span>
        </figcaption>
      </figure>
    </section>

    <!-- impact -->
    <section class="wrap impact" aria-label={t.highlights} data-reveal>
      {
        impact.map((n) => (
          <div class:list={['impact-cell', { accent: n.accent, 'has-logo': n.logo }]}>
            {n.logo && <img class="impact-logo" src={n.logo} alt="ITA" width="124" height="47" loading="lazy" />}
            <b {...(n.count ? { 'data-count': n.count, 'data-suffix': n.suffix } : {})}>{n.value}</b>
            <span class="what">{n.label}</span>
            <span class="detail">{n.detail}</span>
          </div>
        ))
      }
    </section>

    <ChiefOfStaff lang={lang} />

    <!-- systems -->
    <section class="block wrap" id="systems" aria-labelledby="systems-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>02</i><span>{t.sysKicker}</span></div>
          <h2 id="systems-title" set:html={t.sysTitle} />
        </div>
        <p>{t.sysLead}</p>
      </div>
      <div data-reveal>
        <Systems lang={lang} />
      </div>
    </section>

    <!-- selected work -->
    <section class="block wrap" id="work" aria-labelledby="work-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>03</i><span>{t.workKicker}</span></div>
          <h2 id="work-title" set:html={t.workTitle} />
        </div>
        <p>{t.workLead}</p>
      </div>

      {
        featured.map((p) => (
          <article class:list={['feature', p.slug]} data-reveal>
            <div class="feature-body">
              <div class="feature-meta mono">
                <span class:list={{ live: p.status }}>{p.kind}</span>
                <span>{p.year}</span>
              </div>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              {p.points && (
                <ul class="points">
                  {p.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              {p.stats && (
                <div class="stats">
                  {p.stats.map((s) => (
                    <div>
                      <b>{s.value}</b>
                      <span>{s.label}</span>
                    </div>
                  ))}
                </div>
              )}
              <ul class="tags" aria-label={t.stack}>
                {p.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              {p.status && (
                <p class="status mono">
                  <span class="pulse" aria-hidden="true" />
                  {p.status}
                </p>
              )}
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l, i) => (
                    <a class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.href} {...ext(l.href)}>
                      {l.label} <Fragment set:html={arrow} />
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="feature-media">
              {p.slug === 'medalvo' && (
                <div class="browser">
                  <div class="browser-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span>medalvo.com.br</span>
                  </div>
                  <video data-inview muted loop playsinline preload="metadata" poster="/media/medalvo-poster.jpg" aria-label={t.medalvoVideo}>
                    <source src="/media/medalvo.webm" type="video/webm" />
                    <source src="/media/medalvo.mp4" type="video/mp4" />
                  </video>
                </div>
              )}
              {p.slug === 'penpad' && (
                <div class="sheet-wrap">
                  <Handwriting alt={t.penpadAlt} replay={t.writeAgain} />
                </div>
              )}
              {p.slug === 'curo' && (
                <div class="browser">
                  <div class="browser-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span>usecuro.vercel.app</span>
                  </div>
                  <video data-inview muted loop playsinline preload="metadata" poster={lang === 'pt' ? '/media/curo-poster.jpg' : '/media/curo-en-poster.jpg'} aria-label={t.curoVideo}>
                    <source src={lang === 'pt' ? '/media/curo.webm' : '/media/curo-en.webm'} type="video/webm" />
                    <source src={lang === 'pt' ? '/media/curo.mp4' : '/media/curo-en.mp4'} type="video/mp4" />
                  </video>
                </div>
              )}
              {p.slug === 'flights' && (
                <div class="route" aria-label={t.routeAria}>
                  <svg viewBox="0 0 560 360" role="img">
                    <title>{t.routeTitle}</title>
                    <path id="leg-a" class="leg" d="M70 250 C 170 120, 260 110, 300 170" />
                    <path class="leg-direct" d="M70 250 C 150 330, 250 300, 300 170" />
                    <path class="leg-skip" d="M300 170 C 360 230, 430 250, 490 210" />
                    <circle class="ap" cx="70" cy="250" r="9" />
                    <circle class="ap hit" cx="300" cy="170" r="11" />
                    <circle class="ap ghost" cx="490" cy="210" r="9" />
                    <circle class="plane" r="6">
                      <animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.7;1" calcMode="linear">
                        <mpath href="#leg-a" />
                      </animateMotion>
                    </circle>
                    <text x="70" y="285" class="code">SSA</text>
                    <text x="300" y="138" class="code">CGH</text>
                    <text x="490" y="245" class="code ghost">FLN</text>
                    <text x="70" y="304" class="city">Salvador</text>
                    <text x="300" y="120" class="city">{t.routeGetOff}</text>
                    <text x="490" y="264" class="city ghost">{t.routeNever}</text>
                    <g class="tag direct" transform="translate(120 318)">
                      <rect width="150" height="30" rx="15" />
                      <text x="75" y="20">{t.routeDirect}</text>
                    </g>
                    <g class="tag best" transform="translate(130 62)">
                      <rect width="190" height="30" rx="15" />
                      <text x="95" y="20">SSA→CGH→FLN · R$248</text>
                    </g>
                    <g class="save" transform="translate(400 70)">
                      <rect width="120" height="44" rx="12" />
                      <text x="60" y="29">−R$133</text>
                    </g>
                  </svg>
                </div>
              )}
            </div>
          </article>
        ))
      }

      <!-- Ápice -->
      <article class="apice" data-reveal>
        <div class="apice-left">
        <div class="apice-head">
          <div class="feature-meta mono">
            <span>{apice.kind}</span>
            <span>{apice.year}</span>
          </div>
          <h3>{apice.name}</h3>
          <p>{apice.blurb}</p>
          <a class="btn btn-sm btn-primary" href={apice.href} target="_blank" rel="noopener">{t.seeApice} <Fragment set:html={arrow} /></a>
        </div>
        <ul class="apice-work">
          {
            apice.work.map((w) => (
              <li>
                <span class="mono">{w.client}</span>
                <h4>{w.name}</h4>
                <p>{w.what}</p>
              </li>
            ))
          }
        </ul>
        </div>
        <div class="apice-media">
          <div class="browser">
            <div class="browser-bar" aria-hidden="true">
              <i />
              <i />
              <i />
              <span>software-house-six.vercel.app</span>
            </div>
            <video data-inview muted loop playsinline preload="metadata" poster="/media/apice-poster.jpg" aria-label={t.apiceVideo}>
              <source src="/media/apice.webm" type="video/webm" />
              <source src="/media/apice.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </article>

      <ul class="index" data-reveal>
        {
          more.map((p) => (
            <li>
              <a href={p.links[0].href} target="_blank" rel="noopener">
                <span class="name">{p.name}</span>
                <span class="kind mono">{p.kind}</span>
                <span class="blurb">{p.blurb}</span>
                <Fragment set:html={arrowUp} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="index-foot">
        <a class="textlink" href={person.github} target="_blank" rel="noopener">{t.githubAll}</a>
      </div>
    </section>

    <!-- journey -->
    <section class="block wrap" id="log" aria-labelledby="log-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>04</i><span>{t.logKicker}</span></div>
          <h2 id="log-title" set:html={t.logTitle} />
        </div>
        <p>{t.logLead}</p>
      </div>

      <div class="log">
        {
          jobs.map((j) => (
            <article class="entry" data-reveal>
              <span class="dates mono">{j.dates}</span>
              <div class="entry-main">
                <h3 class="co">
                  {j.company}
                  <small>{j.role}</small>
                </h3>
                <p>{j.summary}</p>
                <ul>
                  {j.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
              <span class="place">{j.place}</span>
            </article>
          ))
        }
      </div>

      <div class="log-more">
        <div data-reveal>
          <h3 class="mono sub-head">{t.earlierHead}</h3>
          <ul class="mini">
            {
              earlier.map((e) => (
                <li>
                  <span class="dates mono">{e.dates}</span>
                  <span class="who">
                    <b>{e.company}</b> {e.role}
                  </span>
                  <span class="note">{e.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal>
          <h3 class="mono sub-head">{t.buildingHead}</h3>
          <ul class="mini">
            {
              building.map((e) => (
                <li>
                  <span class="dates mono">{e.dates}</span>
                  <span class="who">
                    <b>{e.name}</b> {e.role}
                  </span>
                  <span class="note">{e.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- medals -->
    <section class="block wrap" id="honors" aria-labelledby="honors-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>05</i><span>{t.honorsKicker}</span></div>
          <h2 id="honors-title" set:html={t.honorsTitle} />
        </div>
        <p>{t.honorsLead}</p>
      </div>

      <div class="medals">
        {
          medals.map((m) => (
            <figure class:list={['medal-card', m.kind]} data-tilt data-reveal>
              <div class="medal-wrap">
                <Medal kind={m.kind} mark={m.rank} sub={t.medalSub[m.kind]} ring={m.ring} />
              </div>
              <figcaption>
                <span class="mono scope">
                  <img src={m.logo} alt="" width="28" height="28" loading="lazy" />
                  {t.international} · {m.year}
                </span>
                <b>{m.title}</b>
                <span>{m.event} ({m.short})</span>
                <small>{m.note}</small>
              </figcaption>
            </figure>
          ))
        }
        <div class="medal-card bulk" data-reveal data-medals>
          <span class="mono scope">{t.nationalScope}</span>
          <b class="big" data-count="50" data-suffix="+">50+</b>
          <span class="bulk-label">{t.nationalLabel}</span>
          <ul class="chips">
            {
              national.map((n) => (
                <li title={n.full}>
                  <b>{n.name}</b> {n.result}
                </li>
              ))
            }
          </ul>
          <button class="btn btn-sm btn-primary see-all" type="button" data-medals-open aria-expanded="false" aria-controls="medal-list">
            {t.seeAll} <Fragment set:html={arrow} />
          </button>
          <div class="medal-list" id="medal-list" hidden>
            <div class="medal-list-head">
              <span class="mono">{t.mainMedals(medalList.length)}</span>
              <button class="close" type="button" data-medals-close aria-label={t.closeList}>×</button>
            </div>
            <ul>
              {
                medalList.map((m) => (
                  <li>
                    <i class:list={['m-dot', m.medal]} aria-label={t.medalWord[m.medal]} />
                    <span class="mono y">{m.year}</span>
                    <span class="n">{m.name}</span>
                    <span class="mono sc">{m.scope}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="receipts">
        <figure class="receipt cert" data-reveal>
          <div class="paper">
            <img src={receipts.certificate.src} width="1100" height="778" loading="lazy" decoding="async" alt={t.certAlt} />
          </div>
          <figcaption>
            <span>{receipts.certificate.caption}</span>
            <a class="textlink mono" href={receipts.certificate.announcement} target="_blank" rel="noopener">{t.sbf}</a>
          </figcaption>
        </figure>

        <figure class="receipt table" data-reveal>
          <div class="sheet-doc">
            <div class="doc-title">
              <span>Olimpiada Iberoamericana de Física 2020</span>
              <b>MEDALLERO</b>
            </div>
            <table>
              <thead>
                <tr>{receipts.oibfRow.cols.map((c) => <th>{c}</th>)}</tr>
              </thead>
              <tbody>
                <tr class="me">{receipts.oibfRow.row.map((c, i) => <td class:list={{ gold: i === 3 }}>{c}</td>)}</tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
                <tr class="blur" aria-hidden="true"><td colspan="5"></td></tr>
              </tbody>
            </table>
          </div>
          <figcaption>
            <span>{receipts.oibfRow.caption}</span>
            <a class="textlink mono" href={receipts.certificate.medalTable} target="_blank" rel="noopener">{t.medalTable}</a>
          </figcaption>
        </figure>

        <figure class="receipt score" data-reveal>
          <div class="sheet-doc">
            <div class="doc-title">
              <span>{t.nbphoTitle}</span>
              <b><em>{receipts.nbpho.total}</em> / {receipts.nbpho.max} pts · #{receipts.nbpho.rank}</b>
            </div>
            <ul class="bars">
              {
                receipts.nbpho.problems.map((pr) => (
                  <li style={`--w:${((pr.got / pr.max) * 100).toFixed(1)}%`} class:list={{ full: pr.got === pr.max }}>
                    <span class="mono">P{pr.n}</span>
                    <i />
                    <span class="mono v">
                      {pr.got}/{pr.max}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <figcaption>
            <span>{t.nbphoCaption}</span>
            <a class="textlink mono" href={receipts.nbpho.href} target="_blank" rel="noopener">{t.nbphoLink}</a>
          </figcaption>
        </figure>
      </div>

      <h3 class="mono sub-head gallery-head" data-reveal>{t.recognition}</h3>
      <div class="gallery">
        {
          otherHonors.map((h) => (
            <figure class="honor-mini" data-reveal>
              <div class="honor-photo">
                <img src={h.photo} width={h.w} height={h.h} loading="lazy" decoding="async" alt={h.alt} style={h.focus ? `object-position:${h.focus}` : undefined} />
              </div>
              <figcaption>
                <b>{h.title}</b>
                <span>{h.event}</span>
                <small>{h.note}</small>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="honor-row">
        <div class="school" data-reveal>
          <img class="school-logo" src={education.logo} alt={t.itaAlt} width="496" height="188" loading="lazy" />
          <div class="school-copy">
            <span class="mono">{t.education} · {education.dates}</span>
            <h3>{education.school}</h3>
            <p>{education.degree}. {education.note}</p>
          </div>
          <div class="school-entry">
            {
              education.entry.map((e) => (
                <div>
                  <b>{e.value}</b>
                  <span>{e.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- how I work -->
    <section class="block wrap" id="how" aria-labelledby="how-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>06</i><span>{t.howKicker}</span></div>
          <h2 id="how-title" set:html={t.howTitle} />
        </div>
      </div>

      <div class="work-grid">
        <div class="prose" data-reveal>
          <p set:html={t.how1} />
          <p set:html={t.how2} />
          <div class="terminal">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <pre><span class="p">~</span> tmux attach -t fleet
  agent-1  feat/streaming     <span class="ok">{t.evalsPassing}</span>
  agent-2  fix/retry-backoff  <span class="ok">{t.evalsPassing}</span>
  agent-3  chore/qa-batch     {t.running}</pre>
          </div>
          <p class="term-note mono">{t.termNote}</p>
        </div>

        <div class="toolbox" data-reveal>
          {
            toolbox.map((g) => (
              <div>
                <span class="mono">{g.area}</span>
                <ul class="tags">
                  {g.items.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- contact -->
    <section class="contact wrap" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" data-reveal set:html={t.contactTitle} />
      <div class="contact-row" data-reveal>
        <a class="btn btn-primary" href={`mailto:${person.email}`}>{person.email} <Fragment set:html={arrow} /></a>
        <button class="btn btn-ghost copy" type="button" data-copy={person.email}><span class="label" data-copied-text={t.copied}>{t.copyEmail}</span></button>
        <a class="btn btn-ghost" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href={person.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Base>
