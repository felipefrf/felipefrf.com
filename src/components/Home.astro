---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Handwriting from '../components/Handwriting.astro';
import Hero from '../components/Hero.astro';
import MedAlvo from '../components/MedAlvo.astro';
import Imperio from '../components/Imperio.astro';
import Film from '../components/Film.astro';
import Showcase from '../components/Showcase.astro';
import '../styles/home.css';
import '../styles/night.css';
import { getSite } from '../data';
import { ui, type Lang } from '../i18n/ui';
import { day } from '../data/day';
import { existsSync, readdirSync } from 'node:fs';
import '@fontsource-variable/libre-franklin';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/day.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const d = day[lang];
// a film shows only once its frames have been rendered (3d/film_*.py)
const hasFilm = (id: string) => existsSync(`public/film/${id}/film.json`);
// company marks, shown small and in ink so they read as type, not as ads
const LOGOS: Record<string, string> = {
  Hexagon: '/img/logos/hexagon.svg',
  'NG.CASH': '/img/logos/ngcash.svg',
  Credix: '/img/logos/credix.png',
  LinkedIn: '/img/logos/linkedin.svg',
  Safra: '/img/logos/safra.svg',
  'BTG Pactual': '/img/logos/btg.svg',
  BTG: '/img/logos/btg.svg',
  'XP Inc.': '/img/logos/xp.svg',
  XP: '/img/logos/xp.svg',
  ITA: '/img/ita.png',
  MedAlvo: '/img/logos/medalvo.svg',
};
// photos of the fair go in public/img/fair/ (shown as soon as they exist)
const fairPhotos = existsSync('public/img/fair') ? readdirSync('public/img/fair').filter((f) => /^\d.*\.(webp|jpe?g|png)$/.test(f)).sort().map((f) => `/img/fair/${f}`) : [];
const logoOf = (name: string) => LOGOS[name] ?? LOGOS[name.split(' ')[0]];
const {
  person,
  impact,
  featured,
  apice,
  more,
  jobs,
  earlier,
  building,
  medals,
  receipts,
  medalList,
  national,
  otherHonors,
  education,
} = getSite(lang);


const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrowUp = `<svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<Base lang={lang} title={t.title} description={t.description} theme="day">
  <a class="skip" href="#main">{t.skip}</a>
  <Nav
    lang={lang}
    links={[
      { href: '#hexagon', label: d.nav.hexagon },
      { href: '#log', label: d.nav.journey },
      { href: '#medalvo', label: 'MedAlvo' },
      { href: '#imperio', label: 'Império' },
      { href: '#work', label: d.nav.work },
      { href: '#honors', label: d.nav.education },
    ]}
    cta={{ href: '#contact', label: t.nav.contact }}
  />

  <main id="main">
    <Hero lang={lang} cta={{ href: '#hexagon', label: d.heroCta }} />

    <!-- impact: professional proof first -->
    <section class="wrap impact" aria-label={t.highlights} data-reveal>
      {
        d.impact.map((n) => (
          <div class="impact-cell">
            <b>{n.value}</b>
            <span class="what">{n.label}</span>
            <span class="detail">{n.detail}</span>
          </div>
        ))
      }
    </section>

    <!-- 01 Hexagon -->
    <section class="block wrap" id="hexagon" aria-labelledby="hexagon-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>01</i><span>{d.hexagon.kicker}</span></div>
          <h2 id="hexagon-title" data-split-lines set:html={d.hexagon.title} />
        </div>
        <p>{d.hexagon.lead}</p>
      </div>
      {hasFilm('hexagon') && <Film lang={lang} id="hexagon" />}
      <div class="hex-foot" data-reveal>
        <h3 class="mono sub-head">{d.hexagon.howHead}</h3>
        <div class="how-cols">
          <p set:html={t.how1} />
          <p><Fragment set:html={t.how2} /> <a class="textlink" href={d.hexagon.link.href} target="_blank" rel="noopener">{d.hexagon.link.label}&nbsp;↗</a></p>
        </div>
      </div>
    </section>

    <!-- 02 journey -->
    <section class="block wrap" id="log" aria-labelledby="log-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>02</i><span>{d.journey.kicker}</span></div>
          <h2 id="log-title" set:html={d.journey.title} />
        </div>
        <p>{d.journey.lead}</p>
      </div>

      <!-- three roles, each with the one thing it's remembered for -->
      <div class="roles">
        {
          jobs.slice(1).map((j, k) => {
            const r = d.roles[j.company as keyof typeof d.roles];
            return (
              <article class="role" data-reveal style={`--k:${k}`}>
                <header>
                  {logoOf(j.company) && <span class="co-logo"><img src={logoOf(j.company)} alt="" loading="lazy" /></span>}
                  <div>
                    <h3>{j.company}</h3>
                    <span>{j.role}</span>
                  </div>
                </header>
                <div class:list={['role-viz', `viz-${k}`]} aria-hidden="true">
                  {k === 0 && (
                    <svg viewBox="0 0 240 90">
                      <rect class="track" x="0" y="30" width="240" height="14" rx="7" />
                      <rect class="was" x="0" y="30" width="240" height="14" rx="7" />
                      <rect class="now" x="0" y="30" width="12" height="14" rx="7" />
                      <text x="0" y="70" class="mono">{lang === 'pt' ? 'antes' : 'before'}</text>
                      <text x="240" y="70" class="mono" text-anchor="end">{lang === 'pt' ? 'depois' : 'after'}</text>
                    </svg>
                  )}
                  {k === 1 && (
                    <svg viewBox="0 0 240 90">
                      {Array.from({ length: 24 }, (_, i) => {
                        const h = 14 + ((i * 37) % 52);
                        return <rect class:list={['bar', { risk: i % 7 === 5, flag: i === 17 }]} x={i * 10} y={78 - h} width="6" height={h} rx="2" style={`--i:${i}`} />;
                      })}
                    </svg>
                  )}
                  {k === 2 && (
                    <svg viewBox="0 0 240 90">
                      <rect class="ask" x="0" y="6" width="150" height="24" rx="12" />
                      <text x="14" y="22" class="mono">{lang === 'pt' ? 'previsão Q3, costa leste?' : 'Q3 forecast, East?'}</text>
                      {[30, 44, 38, 56, 62].map((h, i) => <rect class="col" x={92 + i * 30} y={86 - h} width="18" height={h} rx="3" style={`--i:${i}`} />)}
                    </svg>
                  )}
                </div>
                <p class="role-big"><b class:list={{ word: !/^[−+\-\d]/.test(r.big) }}>{r.big}</b> <span>{r.label}</span></p>
                <ul class="chips">{r.chips.map((c) => <li>{c}</li>)}</ul>
                <footer class="mono">{j.dates} · {j.place}</footer>
              </article>
            );
          })
        }
      </div>

      <!-- shorter stints, one line each -->
      <div class="earlier" data-reveal>
        <span class="mono sub">{d.earlierHead}</span>
        {
          earlier.map((e) => (
            <div class="earlier-item">
              {logoOf(e.company) && <img src={logoOf(e.company)} alt={e.company} loading="lazy" />}
              <span><b>{e.role}</b> <small class="mono">{e.dates}</small></span>
            </div>
          ))
        }
      </div>

      <!-- the ITA career fair, the biggest thing I've led -->
      <h3 class="mono sub-head imp-sub" data-reveal>{d.leadHead}</h3>
      <article class="fair2" data-reveal>
        <div class="fair-mosaic">
          {fairPhotos[0] && <img class="m0" src={fairPhotos[0]} alt={d.fair.photoAlt} loading="lazy" decoding="async" />}
          <button class="fair-video m1" type="button" data-yt="9JT7Rmdbf9k" aria-label={d.video}>
            <img src="/img/fair/video.webp" alt="" loading="lazy" decoding="async" />
            <span class="play"><i /></span>
            <span class="cap mono">{d.video}</span>
          </button>
          {fairPhotos.slice(1, 5).map((f, i) => <img class={`m${i + 2}`} src={f} alt={d.fair.photoAlt} loading="lazy" decoding="async" />)}
        </div>
        <div class="fair-side">
          <span class="mono kicker">{d.fair.kicker}</span>
          <h3>{d.fair.title}</h3>
          <dl class="fair-stats">
            {
              d.fair.stats.map((x) => (
                <div>
                  <dt>{x.value}</dt>
                  <dd>{x.label}</dd>
                </div>
              ))
            }
          </dl>
          <p class="feynman">{d.feynman}</p>
        </div>
      </article>
    </section>

    <MedAlvo lang={lang} n="03" />
    <Imperio lang={lang} n="04" />

    <!-- 05 chief of staff -->
    <section class="block wrap" id="chief" aria-labelledby="chief-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>05</i><span>{d.cos.kicker}</span></div>
          <h2 id="chief-title" data-split-lines set:html={d.cos.title} />
        </div>
        <p>{d.cos.lead}</p>
      </div>
      {
        existsSync('public/media/cos/manifest.json') ? (
          <Showcase lang={lang} dir="cos" url="cos.felipefrf.com" />
        ) : (
          <div class="cos">
            <figure class="cos-phone" data-reveal>
              <div class="phone">
                <span class="phone-notch" aria-hidden="true" />
                <div class="phone-screen">
                  <video data-inview muted loop playsinline preload="none" poster="/media/cos-app-poster.jpg" aria-label={t.chief.videoLabel}>
                    <source src="/media/cos-app.webm" type="video/webm" />
                    <source src="/media/cos-app.mp4" type="video/mp4" />
                  </video>
                </div>
              </div>
            </figure>
            <div class="cos-side">
              <ol class="cos-steps" data-reveal>
                {t.chief.steps.map((s, i) => (
                  <li>
                    <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        )
      }
    </section>


    <!-- 05 side projects -->
    <section class="block wrap" id="work" aria-labelledby="work-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>06</i><span>{d.work.kicker}</span></div>
          <h2 id="work-title" set:html={d.work.title} />
        </div>
        <p>{d.work.lead}</p>
      </div>

      {(() => { const p = featured.find((x) => x.slug === 'curo')!; return (
          <article class:list={['feature', p.slug]} data-reveal>
            <div class="feature-body">
              <div class="feature-meta mono">
                <span class:list={{ live: p.status }}>{p.kind}</span>
                <span>{p.year}</span>
              </div>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              {p.points && (
                <ul class="points">
                  {p.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              {p.stats && (
                <div class="stats">
                  {p.stats.map((s) => (
                    <div>
                      <b>{s.value}</b>
                      <span>{s.label}</span>
                    </div>
                  ))}
                </div>
              )}
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l, i) => (
                    <a class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.href} {...ext(l.href)}>
                      {l.label} <Fragment set:html={arrow} />
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="feature-media">
              {p.slug === 'penpad' && (
                <div class="sheet-wrap">
                  <Handwriting alt={t.penpadAlt} replay={t.writeAgain} />
                </div>
              )}
              {p.slug === 'curo' && (
                <a class="curo-loop" href="/curo/" aria-label={t.curoVideo}>
                  <video data-inview muted loop playsinline preload="none" poster={lang === 'pt' ? '/media/curo/hero.jpg' : '/media/curo/hero-en.jpg'} aria-label={t.curoVideo}>
                    <source src={lang === 'pt' ? '/media/curo/hero.webm' : '/media/curo/hero-en.webm'} type="video/webm" />
                    <source src={lang === 'pt' ? '/media/curo/hero.mp4' : '/media/curo/hero-en.mp4'} type="video/mp4" />
                  </video>
                </a>
              )}
              {p.slug === 'flights' && (
                <a class="browser flights-shot" href="/flights/" aria-label={t.routeAria}>
                  <div class="browser-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span>felipefrf.com/flights</span>
                  </div>
                  <img src="/img/flights-demo.webp" width="1000" height="844" loading="lazy" decoding="async" alt={t.routeAria} />
                </a>
              )}
            </div>
          </article>
); })()}

      <div class="side-grid">
        <article class="side-card" data-reveal>
          <div class="side-media side-film">
            <Film lang={lang} id="flights" compact />
          </div>
          <div class="side-body">
            <div class="feature-meta mono"><span>{d.flights.kind}</span><span>2026</span></div>
            <h3>{d.flights.name}</h3>
            <p>{d.flights.blurb}</p>
            <a class="btn btn-sm btn-primary" href="/flights/">{d.flights.cta} <Fragment set:html={arrow} /></a>
          </div>
        </article>
        {(() => { const pp = featured.find((x) => x.slug === 'penpad')!; return (
          <article class="side-card" data-reveal>
            <div class="side-media side-pen">
              <div class="sheet-wrap">
                <Handwriting alt={t.penpadAlt} replay={t.writeAgain} />
              </div>
            </div>
            <div class="side-body">
              <div class="feature-meta mono"><span>{pp.kind}</span><span>{pp.year}</span></div>
              <h3>{pp.name}</h3>
              <p>{pp.blurb}</p>
              <div class="links">
                {pp.links.map((l, i) => (
                  <a class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.href} {...ext(l.href)}>{l.label} <Fragment set:html={arrow} /></a>
                ))}
              </div>
            </div>
          </article>
        ); })()}
      </div>



      <ul class="index" data-reveal>
        {
          more.map((p) => (
            <li>
              <a href={p.links[0].href} target="_blank" rel="noopener">
                <span class="name">{p.name}</span>
                <span class="kind mono">{p.kind}</span>
                <span class="blurb">{p.blurb}</span>
                <Fragment set:html={arrowUp} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="index-foot">
        <a class="textlink" href={person.github} target="_blank" rel="noopener">{t.githubAll}</a>
      </div>
    </section>

    <!-- 06 education & olympiads -->
    <section class="block wrap" id="honors" aria-labelledby="honors-title">
      <div class="sec-head" data-reveal>
        <div>
          <div class="mono"><i>07</i><span>{d.education.kicker}</span></div>
          <h2 id="honors-title" set:html={d.education.title} />
        </div>
        <p>{d.education.lead}</p>
      </div>

      <div class="honor-row">
        <div class="school" data-reveal>
          <img class="school-logo" src={education.logo} alt={t.itaAlt} width="496" height="188" loading="lazy" />
          <div class="school-copy">
            <span class="mono">{t.education} · {education.dates}</span>
            <h3>{education.school}</h3>
            <p>{education.degree}. {education.note}</p>
          </div>
          <div class="school-entry">
            {
              education.entry.map((e) => (
                <div>
                  <b>{e.value}</b>
                  <span>{e.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="medals">
        {
          medals.map((m) => (
            <figure class:list={['medal-card', m.kind]} data-tilt data-reveal>
              <div class="medal-wrap">
                <canvas class="medal-3d" data-medal={`/3d/medal-${m.kind}-${lang}.glb`} role="img" aria-label={`${m.title}, ${m.event}. ${t.dragMedal}`}></canvas>
                <span class="medal-hint mono" aria-hidden="true">{t.dragMedal}</span>
              </div>
              <figcaption>
                <span class="mono scope">
                  <img src={m.logo} alt="" width="28" height="28" loading="lazy" />
                  {t.international} · {m.year}
                </span>
                <b>{m.title}</b>
                <span>{m.event} ({m.short})</span>
                <small>{m.note}</small>
              </figcaption>
            </figure>
          ))
        }
        <div class="medal-card bulk" data-reveal data-medals>
          <span class="mono scope">{t.nationalScope}</span>
          <b class="big" data-count="50" data-suffix="+">50+</b>
          <span class="bulk-label">{t.nationalLabel}</span>
          <ul class="chips">
            {
              national.map((n) => (
                <li title={n.full}>
                  <b>{n.name}</b> {n.result}
                </li>
              ))
            }
          </ul>
          <button class="btn btn-sm btn-primary see-all" type="button" data-medals-open aria-expanded="false" aria-controls="medal-list">
            {t.seeAll} <Fragment set:html={arrow} />
          </button>
          <div class="medal-list" id="medal-list" hidden>
            <div class="medal-list-head">
              <span class="mono">{t.mainMedals(medalList.length)}</span>
              <button class="close" type="button" data-medals-close aria-label={t.closeList}>×</button>
            </div>
            <ul>
              {
                medalList.map((m) => (
                  <li>
                    <i class:list={['m-dot', m.medal]} aria-label={t.medalWord[m.medal]} />
                    <span class="mono y">{m.year}</span>
                    <span class="n">{m.name}</span>
                    <span class="mono sc">{m.scope}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      
      <div class="receipts">

        <figure class="receipt doc nbpho" data-reveal>
          <a class="doc-sheet" href={receipts.nbpho.href} target="_blank" rel="noopener">
            <img src={receipts.nbpho.src} width={receipts.nbpho.w} height={receipts.nbpho.h} loading="lazy" decoding="async" alt={t.nbphoCaption} />
          </a>
          <figcaption>
            <span>{t.nbphoCaption}</span>
            <a class="textlink mono" href={receipts.nbpho.href} target="_blank" rel="noopener">{t.nbphoLink}</a>
          </figcaption>
        </figure>

        <figure class="receipt doc" data-reveal>
          <a class="doc-sheet" href={receipts.oibf.href} target="_blank" rel="noopener">
            <img src={receipts.oibf.src} width={receipts.oibf.w} height={receipts.oibf.h} loading="lazy" decoding="async" alt={receipts.oibf.caption} />
          </a>
          <figcaption>
            <span>{receipts.oibf.caption}</span>
            <a class="textlink mono" href={receipts.oibf.href} target="_blank" rel="noopener">{t.medalTable}</a>
          </figcaption>
        </figure>

      </div>

      
      <h3 class="mono sub-head gallery-head" data-reveal>{t.recognition}</h3>
      <div class="gallery">
        {
          otherHonors.map((h) => (
            <figure class="honor-mini" data-reveal>
              <div class="honor-photo">
                <img src={h.photo} width={h.w} height={h.h} loading="lazy" decoding="async" alt={h.alt} style={h.focus ? `object-position:${h.focus}` : undefined} />
              </div>
              <figcaption>
                <b>{h.title}</b>
                <span>{h.event}</span>
                <small>{h.note}</small>
              </figcaption>
            </figure>
          ))
        }
      </div>

          </section>

    <!-- contact -->
    <section class="contact wrap" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" data-reveal set:html={t.contactTitle} />
      <div class="contact-row" data-reveal>
        <a class="btn btn-primary" href={`mailto:${person.email}`}>{person.email} <Fragment set:html={arrow} /></a>
        <button class="btn btn-ghost copy" type="button" data-copy={person.email}><span class="label" data-copied-text={t.copied}>{t.copyEmail}</span></button>
        <a class="btn btn-ghost" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href={person.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
  <script>
    import '../scripts/night.ts';
  </script>
</Base>
