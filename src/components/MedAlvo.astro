---
// MedAlvo: numbers, then a stage with four views: the Android app (a question
// you can answer), the Claude connector (an animated tool-call run), the web
// recording and the engine.
import { ventures } from '../data/ventures';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  n: string;
}
const { lang, n } = Astro.props;
const m = ventures[lang].medalvo;
const p = m.phone;
const letters = ['A', 'B', 'C', 'D'];
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const days = lang === 'pt' ? ['S', 'T', 'Q', 'Q', 'S', 'S', 'D'] : ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---

<section class="block wrap venture medalvo-sec" id="medalvo" aria-labelledby="medalvo-title">
  <div class="sec-head" data-reveal>
    <div>
      <div class="mono"><i>{n}</i><span>{m.kicker}</span></div>
      <h2 id="medalvo-title" data-split-lines set:html={m.title} />
    </div>
    <p>{m.lead}</p>
  </div>

  <div class="v-stats" data-reveal>
    {
      m.stats.map((s) => (
        <div>
          <b {...(s.count ? { 'data-count': s.count } : {})}>{s.value}</b>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>

  <div class="stage" data-stage data-reveal>
    <div class="stage-tabs" role="tablist" aria-label="MedAlvo">
      {
        m.tabs.map((label, i) => (
          <button role="tab" type="button" id={`ma-tab-${i}`} aria-controls={`ma-pane-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-stage-tab={i}>
            <span class="mono">0{i + 1}</span>
            {label}
            <i class="tab-progress" aria-hidden="true" />
          </button>
        ))
      }
    </div>

    <div class="stage-body">
      <!-- 1. Android app -->
      <div class="pane active" role="tabpanel" id="ma-pane-0" aria-labelledby="ma-tab-0" data-pane="0">
        <div class="pane-copy">
          <h3>{m.app.title}</h3>
          <p>{m.app.body}</p>
          <ul class="points">{m.app.points.map((pt) => <li>{pt}</li>)}</ul>
          <p class="pane-note mono">{m.app.note}</p>
        </div>
        <div class="pane-visual">
          <div class="android" data-ma-phone>
            <div class="android-screen ma-ui">
              <div class="ma-status mono" aria-hidden="true"><span>9:41</span><span>▲ ▮</span></div>
              <div class="ma-top">
                <div>
                  <span class="ma-kicker">{p.today}</span>
                  <b class="ma-hello">{p.hello}</b>
                </div>
                <span class="ma-xp"><i>2</i><b data-ma-xp>1,960</b> {p.xp}</span>
              </div>
              <div class="ma-card ma-goal">
                <svg class="ma-ring" viewBox="0 0 64 64" aria-hidden="true">
                  <circle cx="32" cy="32" r="26" class="track" />
                  <circle cx="32" cy="32" r="26" class="fill" data-ma-ring pathLength="20" />
                </svg>
                <div class="ma-ring-n"><b data-ma-done>19</b><small>/20</small></div>
                <div class="ma-goal-copy">
                  <span class="ma-kicker">{p.goal}</span>
                  <b data-ma-left>{p.left}</b>
                  <span class="ma-streak">🔥 {p.streak}</span>
                </div>
                <ol class="ma-week" aria-hidden="true">
                  {days.map((d, i) => <li class:list={{ done: i < 6, today: i === 6 }} data-ma-today={i === 6 ? '' : undefined}><i />{d}</li>)}
                </ol>
              </div>
              <div class="ma-card ma-q">
                <div class="ma-q-head"><span class="ma-tag">● {p.tag}</span><span>{p.of}</span></div>
                <p class="ma-q-text">{p.q}</p>
                <div class="ma-opts" role="group" aria-label={p.q}>
                  {
                    p.opts.map((o, i) => (
                      <button type="button" class="ma-opt" data-ma-opt={i} data-right={i === p.right ? '' : undefined}>
                        <i>{letters[i]}</i>
                        {o}
                      </button>
                    ))
                  }
                </div>
                <p class="ma-feedback" data-ma-feedback data-correct={p.correct} data-wrong={p.wrong} aria-live="polite"></p>
                <p class="ma-why">💡 {p.why}</p>
              </div>
              <div class="ma-card ma-league">
                <span class="ma-avatars" aria-hidden="true"><i>AL</i><i>RM</i><i class="me">Eu</i><i>TS</i></span>
                <div><b>{p.league}</b><small>{p.leagueSub}</small></div>
              </div>
            </div>
          </div>
          <div class="ma-widget" aria-hidden="true">
            <img src="/media/medalvo/icon.svg" alt="" width="28" height="28" />
            <div><b>12</b><small>🔥</small></div>
            <div><b data-ma-widget>19/20</b><small>{p.goal}</small></div>
            <div><b>8</b><small>{lang === 'pt' ? 'revisões' : 'reviews'}</small></div>
          </div>
        </div>
      </div>

      <!-- 2. Claude connector -->
      <div class="pane" role="tabpanel" id="ma-pane-1" aria-labelledby="ma-tab-1" data-pane="1" hidden>
        <div class="pane-copy">
          <h3>{m.claude.title}</h3>
          <p>{m.claude.body}</p>
          <ul class="toolchips mono">{m.claude.tools.map((tl) => <li>{tl}</li>)}</ul>
        </div>
        <div class="pane-visual">
          <div class="mcp-chat" data-chat>
            <div class="mcp-bar mono"><span class="dot" />Claude <span class="dim">· MedAlvo connector</span></div>
            <div class="mcp-log">
              <div class="cm user" data-step="0">{m.claude.user1}</div>
              <div class="cm-tool" data-step="1"><i class="spin" /> MedAlvo · <b>{m.claude.tool1}</b><span>{m.claude.tool1Args}</span></div>
              <div class="cm bot qcard" data-step="2">
                <span class="mono">{m.claude.card}</span>
                <p>{m.claude.cardQ}</p>
                <ol><li>A</li><li class="pick">B</li><li>C</li><li>D</li></ol>
              </div>
              <div class="cm user" data-step="3">{m.claude.user2}</div>
              <div class="cm-tool" data-step="4"><i class="spin" /> MedAlvo · <b>{m.claude.tool2}</b></div>
              <div class="cm bot" data-step="5">{m.claude.reply}</div>
              <div class="cm-tool ok" data-step="6"><i class="spin" /> MedAlvo · <b>{m.claude.tool3}</b></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Web -->
      <div class="pane" role="tabpanel" id="ma-pane-2" aria-labelledby="ma-tab-2" data-pane="2" hidden>
        <div class="pane-copy">
          <h3>{m.web.title}</h3>
          <p>{m.web.body}</p>
        </div>
        <div class="pane-visual">
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><i /><i /><i /><span>medalvo.com.br</span></div>
            <video data-inview muted loop playsinline preload="none" poster="/media/medalvo-poster.jpg" aria-label="MedAlvo">
              <source src="/media/medalvo.webm" type="video/webm" />
              <source src="/media/medalvo.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>

      <!-- 4. Engine -->
      <div class="pane" role="tabpanel" id="ma-pane-3" aria-labelledby="ma-tab-3" data-pane="3" hidden>
        <div class="pane-copy">
          <h3>{m.engine.title}</h3>
          <p>{m.engine.body}</p>
          <dl class="engine-rows">
            {m.engine.rows.map((r) => (
              <div><dt class="mono">{r.k}</dt><dd>{r.v}</dd></div>
            ))}
          </dl>
        </div>
        <div class="pane-visual">
          <div class="pipe">
            <ol>
              {m.engine.pipe.map((s, i) => (
                <li style={`--k:${i}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s}</li>
              ))}
            </ol>
            <i class="pipe-packet" aria-hidden="true" />
            <i class="pipe-packet two" aria-hidden="true" />
            <p class="mono">{m.engine.pipeNote}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="v-foot" data-reveal>
    <ul class="tags" aria-label="Stack">{m.stack.map((s) => <li>{s}</li>)}</ul>
    <a class="btn btn-sm btn-primary magnetic" href="https://medalvo.com.br" target="_blank" rel="noopener">{m.cta} <Fragment set:html={arrow} /></a>
  </div>
</section>
