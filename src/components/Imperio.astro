---
// Império Eventos: the field app, walked through one step at a time. A phone
// shows each real screen (demo account) while the list beside it says what the
// crew does there and why.
import { ventures } from '../data/ventures';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  n: string;
}
const { lang, n } = Astro.props;
const v = ventures[lang].imperio;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="block wrap venture imperio-sec" id="imperio" aria-labelledby="imperio-title">
  <div class="sec-head" data-reveal>
    <div>
      <div class="mono"><i>{n}</i><span>{v.kicker}</span></div>
      <h2 id="imperio-title" data-split-lines set:html={v.title} />
    </div>
    <p>{v.lead}</p>
  </div>

  <div class="imp-walk" data-walk data-reveal>
    <div class="imp-walk-visual">
      <div class="imp-glow" aria-hidden="true"></div>
      <div class="android imp-walk-phone">
        <div class="android-screen"><span class="imp-status mono" aria-hidden="true"><span>12:02</span><span>5G ▮</span></span>
          {
            v.steps.map((s, i) => (
              <img src={s.src} alt={s.alt} width="780" height="1688" loading="lazy" decoding="async" class:list={{ on: i === 0 }} data-walk-img={i} />
            ))
          }
        </div>
      </div>
    </div>

    <div class="imp-walk-copy">
      <p class="imp-walk-kicker mono">{v.walkTitle}</p>
      <ol class="imp-walk-steps">
        {
          v.steps.map((s, i) => (
            <li>
              <button type="button" class:list={{ on: i === 0 }} data-walk-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">
                  <b>{s.title}</b>
                  <span class="d"><span>{s.body}</span></span>
                </span>
                <i class="bar" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ol>
      <p class="imp-note mono">{v.note}</p>
    </div>
  </div>

  <div class="imp-cols" data-reveal>
    <div>
      <h3>{v.crewTitle}</h3>
      <ul class="points">{v.crew.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div>
      <h3>{v.officeTitle}</h3>
      <ul class="points">{v.office.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>

  <div class="v-foot" data-reveal>
    <span class="imp-built mono">{v.built}</span>
    <a class="btn btn-sm btn-gold magnetic" href={v.href} target="_blank" rel="noopener">{v.cta} <Fragment set:html={arrow} /></a>
  </div>
</section>
