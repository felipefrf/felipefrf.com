---
// Império Eventos: the whole system, shown working. The office side (live map,
// arrival forecast, EstoqueNOW orders, agenda, pay, margin) and the field side
// (the bosses' alerts and the crew's day), recorded with demo data.
import { ventures } from '../data/ventures';
import Showcase from './Showcase.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  n: string;
}
const { lang, n } = Astro.props;
const v = ventures[lang].imperio;
const arrow = `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="block wrap venture imperio-sec" id="imperio" aria-labelledby="imperio-title">
  <div class="sec-head" data-reveal>
    <div>
      <div class="mono"><i>{n}</i><span>{v.kicker}</span></div>
      <h2 id="imperio-title" data-split-lines set:html={v.title} />
    </div>
    <p>{v.lead}</p>
  </div>

  <!-- one story, in the order a day happens: the order arrives, the week is
       planned, the crew boards, the office and the boss follow them live, the
       crew counts and gets the sign-off, and the money is settled -->
  <Showcase lang={lang} dir="imperio/v2" url="sistema.imperioeventos.com" only={['office-estoquenow', 'office-live-map', 'office-live-tracking', 'boss-alerts', 'crew-signature', 'office-billing']} />

  <div class="v-foot" data-reveal>
    <span class="imp-built mono">{v.built}</span>
    <a class="btn btn-sm btn-gold magnetic" href={v.href} target="_blank" rel="noopener">{v.cta} <Fragment set:html={arrow} /></a>
  </div>
</section>
