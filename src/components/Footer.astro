---
import { getSite } from '../data';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const { person } = getSite(lang);
const t = ui[lang];
---

<footer class="foot wrap mono">
  <span>© {new Date().getFullYear()} {person.name} · {person.location}</span>
  <span>
    <a href={localePath(lang, '/')}>{t.footer.home}</a> · <a href="/penpad/">penpad</a> · <a href="/curo/">Curo</a> ·
    <a href="/llms.txt">llms.txt</a> ·
    <a href="https://github.com/felipefrf/felipefrf.com" target="_blank" rel="noopener">{t.footer.source}</a>
  </span>
</footer>
