---
// Curo in motion: one patient conversation on the left, the work Curo does
// with the hospital, the insurer and the doctor appearing on the right.
// Without JS everything is shown at once.
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const c = ui[lang].chat;
---

<div class="chat" data-chat>
  <div class="chat-phone" lang="pt-BR">
    <div class="chat-head">
      <span class="av">C<b>.</b></span>
      <div>
        <b>Curo</b>
        <small>{c.online}</small>
      </div>
    </div>
    <div class="chat-body">
      <div class="msg in" data-at="0">{c.inMsg}</div>
      <div class="typing" data-at="1" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="msg out" data-at="5">{c.outMsg}</div>
    </div>
  </div>
  <ul class="chat-behind" aria-label={c.behind}>
    {
      c.steps.map((st, i) => (
        <li data-at={i + 2}>
          <span class="mono">{st.who}</span>
          <b>{st.what}</b>
          <small>{st.when}</small>
        </li>
      ))
    }
  </ul>
  <span class="chat-note mono">{c.note}</span>
</div>
